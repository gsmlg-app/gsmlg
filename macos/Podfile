platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end

  # Add LiteRT-LM desktop setup script phase to the main Runner target.
  # Must use the main project (Runner.xcodeproj), not the Pods project.
  main_project = installer.aggregate_targets.first.user_project
  runner_target = main_project.targets.find { |t| t.name == 'Runner' }

  if runner_target
    # Remove any existing LiteRT-LM phase to avoid duplicates on re-install
    runner_target.build_phases.reject! { |phase|
      phase.respond_to?(:name) && phase.name == 'LiteRT-LM Desktop Setup'
    }

    # Use our own setup script that correctly handles JRE bundling.
    # The flutter_gemma setup_desktop.sh signs JRE with sandbox entitlements,
    # but Xcode's implicit code-signing then corrupts the binary (SIGBUS).
    # Our script copies the JRE from cache on every build to work around this.
    # Use ${SRCROOT} so the path remains portable across machines.
    script_phase = runner_target.new_shell_script_build_phase('LiteRT-LM Desktop Setup')
    script_phase.shell_path = '/bin/bash'
    script_phase.shell_script = <<-SCRIPT
"${SRCROOT}/scripts/setup_litertlm.sh" "${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.app"
    SCRIPT

    main_project.save
  end
end
