#!/bin/sh
set -eu

# greetd opens the ordinary user's PAM/systemd session before running this.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export GDK_BACKEND=wayland

systemctl --user stop gsmlg-kiosk-app.service
trap 'systemctl --user stop gsmlg-kiosk-app.service' 0
/usr/bin/sway --config /etc/gsmlg-kiosk/sway.conf
